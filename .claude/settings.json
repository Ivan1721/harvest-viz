{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run bench)",
      "Bash(node --test *)",
      "Bash(npx vitest run *)",
      "Bash(npx playwright test *)",
      "Bash(npx prettier --check *)",
      "Bash(npx prettier --write *)",
      "Bash(npx eslint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm test)",
      "PowerShell(npm run test:*)",
      "PowerShell(npm run build)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)"
    ]
  }
}
