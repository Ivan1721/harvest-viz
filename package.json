{
  "name": "harvest-viz",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "Visor 3D y simulador de cosecha colaborativa humano-robot (réplica JS de HumanRobot_Sim/HumanOnly_Sim)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivan1721/harvest-viz.git"
  },
  "homepage": "https://ivan1721.github.io/harvest-viz/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:full": "node scripts/test-full.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:all": "cross-env ALL_BROWSERS=1 playwright test",
    "test:visual": "cross-env VISUAL=1 playwright test e2e/visual.spec.js",
    "test:components": "vitest run",
    "test:coverage": "c8 node --test \"tests/**/*.test.mjs\"",
    "test:mutation": "stryker run",
    "bench": "node scripts/bench.mjs",
    "sensitivity": "node scripts/sensitivity.mjs",
    "experimentos": "node scripts/experimentos.mjs",
    "bench:visual": "node scripts/bench-visual.mjs",
    "export:video": "node scripts/export-video.mjs",
    "test:mutation:engine": "stryker run stryker.engine.config.json"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "3.1.3",
    "fflate": "^0.8.3",
    "mediabunny": "^1.61.6",
    "postprocessing": "6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint-react/eslint-plugin": "^5.28.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
