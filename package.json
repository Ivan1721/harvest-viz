{
  "name": "harvest-viz",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Visor 3D y simulador de cosecha colaborativa humano-robot (réplica JS de HumanRobot_Sim/HumanOnly_Sim)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivan1721/harvest-viz.git"
  },
  "homepage": "https://ivan1721.github.io/harvest-viz/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:full": "node scripts/test-full.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:all": "cross-env ALL_BROWSERS=1 playwright test",
    "test:visual": "cross-env VISUAL=1 playwright test e2e/visual.spec.js",
    "test:components": "vitest run",
    "test:coverage": "c8 node --test \"tests/**/*.test.mjs\"",
    "test:mutation": "stryker run",
    "bench": "node scripts/bench.mjs",
    "sensitivity": "node scripts/sensitivity.mjs",
    "bench:visual": "node scripts/bench-visual.mjs",
    "export:video": "node scripts/export-video.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "fflate": "^0.8.3",
    "mediabunny": "^1.61.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@stryker-mutator/core": "^9.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "c8": "^10.1.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
