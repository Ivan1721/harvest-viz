{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Pruebas de mutaci\u00f3n: introduce errores peque\u00f1os en el c\u00f3digo y verifica que alguna prueba falle. Lento: se corre a demanda (npm run test:mutation) o en el workflow semanal.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/unit/*.test.mjs tests/model/analytical.test.mjs tests/data/contracts.test.mjs"
  },
  "mutate": ["src/hrsim/fis.js", "src/hrsim/common.js", "src/workload/derive.js", "src/workload/run.js"],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 30000,
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp"
}
