{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Pruebas de mutación de las piezas puras (FIS, parámetros, series derivadas, lectura de CSV). Runner TAP con cobertura por prueba y caché incremental. El motor tiene su propia configuración (stryker.engine.config.json): instrumentado corre ~25 veces más lento.",
  "testRunner": "tap",
  "mutate": ["src/hrsim/fis.js", "src/hrsim/common.js", "src/workload/derive.js", "src/workload/run.js"],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 30000,
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "tap": {
    "testFiles": ["tests/unit/{fis,derive,geometry,interp,limits}.test.mjs", "tests/model/analytical.test.mjs", "tests/data/contracts.test.mjs"],
    "nodeArgs": ["--test-reporter=tap"]
  }
}
